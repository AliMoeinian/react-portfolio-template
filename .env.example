# Copy only to .env.local for local development. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_OWNER_CHAT_ID=
CALLBACK_SIGNING_SECRET=

GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Local development may use an absolute path to the downloaded PEM file.
GITHUB_PRIVATE_KEY_PATH=
# Vercel uses the inline key below instead of a local file path.
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
GITHUB_OWNER=AliMoeinian
GITHUB_REPOSITORY=react-portfolio-template
# Keep local end-to-end tests isolated from production.
BOT_PUBLISHING_MODE=sandbox
GITHUB_BRANCH=bot-sandbox
GITHUB_PREVIEW_BRANCH=bot-sandbox-preview
